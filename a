  CONSTRAINT chk_fmea_severity CHECK (severity IN ('ALTA', 'MEDIA', 'BAJA')),
  CONSTRAINT chk_fmea_frequency CHECK (frequency IN ('FRECUENTE', 'OCASIONAL', 'RARA')),

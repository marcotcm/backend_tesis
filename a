  description text NOT NULL, -- Resumen del comportamiento anómalo detectado.
  causes jsonb NOT NULL DEFAULT '[]'::jsonb, -- Array JSON con las causas raíz identificadas.
  effects jsonb NOT NULL DEFAULT '{}'::jsonb, -- Objeto JSON mapeando el impacto (Seguridad, Operacional, etc.).
  current_controls jsonb NOT NULL DEFAULT '[]'::jsonb, -- Array JSON con las medidas defensivas vigentes.
  recommended_actions jsonb NOT NULL DEFAULT '[]'::jsonb, -- Array JSON con pasos a seguir para mitigar la falla.
  created_by uuid NOT NULL, -- Autor intelectual del análisis RCM.

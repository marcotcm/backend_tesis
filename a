  CONSTRAINT ai_recs_equipment_fkey FOREIGN KEY (equipment_id) REFERENCES public.equipments(id) ON DELETE CASCADE,
  CONSTRAINT ai_recs_resolved_fkey FOREIGN KEY (resolved_by) REFERENCES public.users(id) ON DELETE SET NULL,
  CONSTRAINT chk_ai_confidence CHECK (confidence_score >= 0 AND confidence_score <= 100),
  CONSTRAINT chk_ai_status CHECK (status IN ('Pendiente', 'Aceptada', 'Rechazada'))
);


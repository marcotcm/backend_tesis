-- =================================================================================

-- =================================================================================
-- 0. CREACIÓN DE TIPOS ENUMERADOS (ENUMS)
-- DESCRIPCIÓN: Tipos de datos personalizados basados en tu panel de Supabase.
-- Deben crearse antes que las tablas que los utilizan.
-- =================================================================================
CREATE TYPE public.turn AS ENUM ('daytime', 'nighttime');
CREATE TYPE public.user_role AS ENUM ('admin', 'rcm_engineer', 'technical_auditor');

-- =================================================================================
-- 1. TABLA: users 
-- =================================================================================
CREATE TABLE public.users (
  id uuid NOT NULL, -- Identificador único del usuario (vinculado a auth.users).
  email character varying NOT NULL UNIQUE, -- Correo electrónico único para acceso y notificaciones.
  first_name character varying NOT NULL, -- Nombre de pila del trabajador.
  last_name character varying NOT NULL, -- Apellidos del trabajador.
  identification_id character varying NOT NULL UNIQUE, -- Cédula de identidad (Formato V-, E-, P-).
  birth_date date, -- Fecha de nacimiento para validar la mayoría de edad.
  phone_number character varying, -- Teléfono de contacto (Formato venezolano +58 o 0).
  employee_badge character varying UNIQUE, -- Número de carnet o ficha corporativa.
  
  -- Aquí se aplican los ENUMs creados arriba
  role public.user_role NOT NULL DEFAULT 'rcm_engineer'::public.user_role, -- Nivel de permisos en el sistema RCM.
  work_shift public.turn NOT NULL DEFAULT 'daytime'::public.turn, -- Turno operativo (diurno, nocturno).
  
  specialty character varying, -- Especialidad técnica (Mecánico, Instrumentista, etc.).
  is_active boolean NOT NULL DEFAULT true, -- Bandera lógica para deshabilitar usuarios sin borrar su historial.
  created_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP, -- Fecha y hora de registro en la plataforma.
  updated_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP, -- Fecha y hora de la última modificación del perfil.
  deleted_at timestamp with time zone, -- Fecha de borrado lógico (si se decide implementar soft-deletes puros).
  
  CONSTRAINT users_pkey PRIMARY KEY (id),

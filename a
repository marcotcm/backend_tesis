-- 11. TABLA: ai_recommendations (Salida de la IA)
-- =================================================================================
CREATE TABLE public.ai_recommendations (
  id uuid DEFAULT gen_random_uuid() NOT NULL, -- ID único del output del motor IA.
  equipment_id uuid NOT NULL, -- Equipo sobre el cual el algoritmo generó la inferencia.
  trigger_source character varying NOT NULL, -- Evento disparador (Anomalía en métrica, Patrón de fallas).
  trigger_reference_id uuid, -- ID externo de lo que gatilló a la IA (Ej: El ID de la métrica anómala).
  recommendation_text text NOT NULL, -- La sugerencia en lenguaje natural generada por el modelo.
  confidence_score numeric NOT NULL, -- Índice porcentual (0-100) de certeza predictiva interna de la IA.
  prediction_type character varying NOT NULL, -- Categoría del consejo (Ajuste de Frecuencia, Alerta de Falla Inminente).
  status character varying NOT NULL DEFAULT 'Pendiente', -- Flujo de validación (Pendiente, Aceptada, Rechazada).
